{
  "name": "compass",
  "version": "0.1.0",
  "private": true,
  "description": "Compass — a structured, on-device personal-growth reflection app. Deterministic, rules-based, no AI/LLM, no server.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "validate-content": "node scripts/validate-content.js",
    "check": "npm run validate-content && npm run typecheck && npm test"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "crypto-es": "^2.1.0",
    "expo": "~51.0.28",
    "expo-crypto": "~13.0.2",
    "expo-secure-store": "~13.0.2",
    "expo-sqlite": "~14.0.6",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~18.2.79",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "~5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json"
    ]
  }
}
